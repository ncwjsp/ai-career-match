# Copy to .env in this directory. In-memory development requires no database,
# no AWS account and no credentials: every cloud adapter below has a local
# default. Never commit a real key; .env is ignored by Git.

APP_ENV=development
APP_MODE=mock

# --- PostgreSQL (see the root .env.example and infra/compose.yaml) ---
APP_DATABASE_URL=postgresql+psycopg://career_app_user:local_app_only@127.0.0.1:5432/career_app
JOB_DATABASE_URL=postgresql+psycopg://career_jobs_user:local_jobs_only@127.0.0.1:5432/career_jobs

# --- Resume object storage (team revision 2026-09-08: AWS S3) ---
# local = filesystem directory below, used by tests, CI and offline work.
# s3    = private AWS S3 bucket; required in deployment.
OBJECT_STORE_BACKEND=local
OBJECT_STORE_LOCAL_DIR=.local-object-store

# Used only when OBJECT_STORE_BACKEND=s3.
AWS_REGION=ap-southeast-1
RESUME_BUCKET=
RESUME_OBJECT_PREFIX=resumes/
# Optional: point the S3 client at MinIO/LocalStack for an offline dry run.
AWS_S3_ENDPOINT_URL=

# --- NLP / embedding inference (team revision 2026-09-08: Amazon SageMaker) ---
# local     = in-process CPU model (M1's packaging); the default for tests/CI.
# sagemaker = invoke the deployed SageMaker endpoint; required in deployment.
EMBEDDING_BACKEND=local
SAGEMAKER_EMBEDDING_ENDPOINT=
SAGEMAKER_REGION=
SAGEMAKER_TIMEOUT_SECONDS=30

# --- AWS credentials ---
# Prefer an instance/task role or a named profile over long-lived keys. boto3
# reads the standard variables below on its own; they are listed here only so
# the required names are visible. Leave them empty in Git.
#   AWS_PROFILE
#   AWS_ACCESS_KEY_ID
#   AWS_SECRET_ACCESS_KEY
#   AWS_SESSION_TOKEN
# Scope the IAM policy to s3:GetObject/PutObject/DeleteObject on
# arn:aws:s3:::<RESUME_BUCKET>/<RESUME_OBJECT_PREFIX>* and
# sagemaker:InvokeEndpoint on the single embedding endpoint. Nothing else.

# --- Explanation LLM (C-02; provider-neutral, Bedrock is one allowed option) ---
# fake = deterministic local adapter used by tests and the default mock mode.
LLM_PROVIDER=fake
LLM_MODEL_ID=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# --- Retained-candidate lifecycle (D06; values are proposals, not measured) ---
PROFILE_RETENTION_DAYS=30
MATCH_BATCH_SIZE=100
MAX_UPLOAD_BYTES=10485760

# --- Manual job import access guard (D09) ---
# Comma-separated shared tokens for the team-only import route. Empty means the
# import route stays closed. Development-grade; not an account system.
IMPORT_ACCESS_TOKENS=
